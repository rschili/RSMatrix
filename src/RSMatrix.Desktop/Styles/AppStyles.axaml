<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RSMatrix.Desktop.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.secondary, SelectableTextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Line icons -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Borderless buttons holding an icon -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Text-like buttons for secondary actions -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Room list -->
  <Style Selector="ListBox.rooms">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="ListBox.rooms ListBoxItem">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.rooms ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
  </Style>
  <Style Selector="ListBox.rooms ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.rooms ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
  </Style>

  <!-- Composer: the surrounding border draws the frame, the text box stays plain -->
  <Style Selector="TextBox.composer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource ComposerBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ComposerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>

  <!-- Timeline -->
  <Style Selector="Border.message">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.message:pointerover">
    <Setter Property="Background" Value="{DynamicResource MessageHoverBrush}" />
  </Style>
  <Style Selector="Border.message TextBlock.hoverTime">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.message:pointerover TextBlock.hoverTime">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.roomName.unread">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource UnreadBadgeBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Ellipse.status.online">
    <Setter Property="Fill" Value="{DynamicResource OnlineBrush}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,8,16,8" />
  </Style>
  <Style Selector="Path.icon.warning">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.message.groupStart">
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector="Border.message.pending">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.message.pinned">
    <Setter Property="Background" Value="{DynamicResource MessageHoverBrush}" />
  </Style>

  <!-- Reactions below a message -->
  <Style Selector="Button.reaction">
    <Setter Property="Background" Value="{DynamicResource ReactionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.reaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReactionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Button.reaction.mine">
    <Setter Property="Background" Value="{DynamicResource ReactionMineBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReactionMineBorderBrush}" />
  </Style>
  <Style Selector="Button.reaction.mine:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReactionMineBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReactionMineBorderBrush}" />
  </Style>
  <Style Selector="Button.reaction TextBlock.count">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.reaction.mine TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource MentionForegroundBrush}" />
  </Style>

  <Style Selector="ItemsControl.reactions">
    <Setter Property="Margin" Value="0,3,0,1" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel ItemSpacing="4" LineSpacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!-- Replies and threads -->
  <Style Selector="Path.replyCurve">
    <Setter Property="Data" Value="M 18 14 V 9 Q 18 5 22 5 H 46" />
    <Setter Property="Stroke" Value="{DynamicResource QuoteBarBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Button.threadSummary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="-6,2,0,0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.threadSummary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
  </Style>
  <Style Selector="Button.threadSummary TextBlock.replies">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.threadRoot">
    <Setter Property="Padding" Value="24,16,90,14" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Path.threadConnector">
    <Setter Property="Data" Value="M 18 -12 V 4 Q 18 9 23 9 H 34" />
    <Setter Property="Stroke" Value="{DynamicResource QuoteBarBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="TextBlock.threadTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.threadTitle.unread">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.moreThreads">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.moreThreads:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.headerRoom">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.headerRoom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Buttons showing a single emoji -->
  <Style Selector="Button.emoji">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.emoji:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
  </Style>

  <!-- Hover actions of a message -->
  <Style Selector="Border.messageActions">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="BoxShadow" Value="0 2 6 0 #1F000000" />
  </Style>
  <Style Selector="Border.message:pointerover Border.messageActions.sent, Border.message.pinned Border.messageActions.sent">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.messageActions Button.icon">
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Border.messageActions Border.separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="3,6" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- Read receipt avatars overlap a little, with a ring in the background color -->
  <Style Selector="Border.reader">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="1.5" />
  </Style>

  <Style Selector="controls|MessageDocumentView.notice">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
</Styles>
