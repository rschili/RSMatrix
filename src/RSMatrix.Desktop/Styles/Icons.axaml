<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Line icons on a 24x24 grid, drawn with a stroke by the "icon" Path style. -->
  <StreamGeometry x:Key="LockIcon">M6.5 11 H17.5 A1.5 1.5 0 0 1 19 12.5 V19.5 A1.5 1.5 0 0 1 17.5 21 H6.5 A1.5 1.5 0 0 1 5 19.5 V12.5 A1.5 1.5 0 0 1 6.5 11 Z M8 11 V7.5 A4 4 0 0 1 16 7.5 V11</StreamGeometry>
  <StreamGeometry x:Key="SendIcon">M4 12 L20 4 L13 20 L11 13 Z M11 13 L20 4</StreamGeometry>
  <StreamGeometry x:Key="SignOutIcon">M10 4 H6 A2 2 0 0 0 4 6 V18 A2 2 0 0 0 6 20 H10 M15 8 L19 12 L15 16 M19 12 H9</StreamGeometry>
  <StreamGeometry x:Key="CloseIcon">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
  <StreamGeometry x:Key="WarningIcon">M12 4 L21 19.5 H3 Z M12 10 V14 M12 16.8 V17</StreamGeometry>
</ResourceDictionary>
