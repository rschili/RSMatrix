<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RSMatrix.Desktop.ViewModels"
             xmlns:views="using:RSMatrix.Desktop.Views"
             xmlns:controls="using:RSMatrix.Desktop.Controls"
             xmlns:chat="using:RSMatrix.Desktop.Chat"
             x:Class="RSMatrix.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             controls:MediaImageView.Loader="{Binding Media}">
  <UserControl.Styles>
    <!-- Narrow windows keep their width for the timeline: no member list, wherever it was left open. -->
    <ContainerQuery Name="Chat" Query="max-width:959">
      <Style Selector="Panel.memberList, Button.memberListToggle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto" Container.Name="Chat" Container.Sizing="Width">

    <!-- Room list -->
    <Border Width="{DynamicResource SidebarWidth}" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,18,18,10">
          <TextBlock Classes="title" Text="Rooms" />
          <TextBlock Grid.Column="1" Classes="caption tertiary" Text="{Binding ServerName}" VerticalAlignment="Center" />
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10,10,10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Panel VerticalAlignment="Center">
              <controls:AvatarView Width="32" Height="32" DisplayName="{Binding CurrentUser.DisplayName}" ColorSeed="{Binding CurrentUser.UserId}" />
              <Ellipse Classes="presenceDot" IsVisible="{Binding IsOnline}"
                       Classes.online="{Binding Presence.IsOnline}" Classes.away="{Binding Presence.IsAway}" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding CurrentUser.UserId}" />
              <!-- While the connection is down, the line shows that instead of the presence. -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsOnline}">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Classes="status" />
                <TextBlock Classes="caption secondary" Text="{Binding ConnectionText}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button x:Name="PresenceButton" Classes="presenceLine" IsVisible="{Binding IsOnline}" ToolTip.Tip="{Binding Presence.LineToolTip}">
                <TextBlock Classes="caption secondary" Text="{Binding Presence.LineText}" TextTrimming="CharacterEllipsis" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft" Opening="OnPresenceMenuOpening">
                    <StackPanel Width="250" Spacing="2">
                      <RadioButton GroupName="PresenceMode" IsChecked="{Binding Presence.IsOnlineMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Classes="presenceMark online" />
                          <TextBlock Text="Online" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton GroupName="PresenceMode" IsChecked="{Binding Presence.IsAwayMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Classes="presenceMark away" />
                          <TextBlock Text="Away" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton GroupName="PresenceMode" IsChecked="{Binding Presence.IsInvisibleMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Classes="presenceMark" />
                          <TextBlock Text="Invisible" />
                        </StackPanel>
                      </RadioButton>
                      <Separator Margin="0,6" />
                      <TextBlock Classes="caption secondary" Text="Status" Margin="0,0,0,4" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBox x:Name="StatusBox" Text="{Binding Presence.StatusDraft}" PlaceholderText="What are you up to?"
                                 MaxLength="100" ToolTip.Tip="Enter saves" />
                        <Button Grid.Column="1" Classes="icon" Padding="6" Command="{Binding Presence.ClearStatusCommand}"
                                ToolTip.Tip="Clear the status">
                          <Path Classes="icon" Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Menu">
              <Path Classes="icon" Data="{StaticResource MoreIcon}" />
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                  <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
                  <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>

        <Panel>
          <ListBox Classes="sidebar" ItemsSource="{Binding SidebarEntries}" SelectedItem="{Binding SelectedConversation}">
            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:RoomViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- The unread badge sits on the room icon, or beside the name when icons are hidden. -->
                  <Panel Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{DynamicResource ShowRoomIcons}">
                    <controls:AvatarView Width="28" Height="28" IsSquare="{Binding !IsDirect}"
                                         DisplayName="{Binding Name}" ColorSeed="{Binding RoomId}" AvatarUrl="{Binding AvatarUrl}" />
                    <Border Classes="badge overlay" IsVisible="{Binding HasUnread}">
                      <TextBlock Text="{Binding UnreadCount}" />
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="roomName" Classes.unread="{Binding HasUnread}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption secondary" Text="{Binding LastMessagePreview}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               IsVisible="{DynamicResource ShowRoomPreviews}" />
                  </StackPanel>
                  <Panel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{DynamicResource ShowRoomBadgeBesideName}">
                    <Border Classes="badge" IsVisible="{Binding HasUnread}">
                      <TextBlock Text="{Binding UnreadCount}" />
                    </Border>
                  </Panel>
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="vm:ThreadViewModel">
                <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="6">
                  <Path Classes="threadConnector" />
                  <TextBlock Grid.Column="1" Classes="caption threadTitle" Classes.unread="{Binding HasUnread}" Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                  <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                    <TextBlock Text="{Binding UnreadCount}" />
                  </Border>
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="vm:MoreThreadsViewModel">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="6">
                  <Button Grid.Column="1" Classes="moreThreads" Content="{Binding Text}" Click="OnMoreThreadsClick" />
                </Grid>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <TextBlock Classes="secondary" Margin="24,8" TextWrapping="Wrap" IsVisible="{Binding !Rooms.Count}"
                     Text="Rooms show up here once they have messages." />
        </Panel>
      </DockPanel>
    </Border>

    <!-- Selected room -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
      <Border Height="56" Padding="24,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
              IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" IsVisible="{Binding SelectedConversation.IsThread}">
            <Button Classes="link headerRoom" Content="{Binding SelectedConversation.Room.Name}"
                    Command="{Binding SelectedConversation.ShowRoomCommand}" ToolTip.Tip="Back to the room" />
            <TextBlock Classes="title tertiary" Text="›" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="title" Text="{Binding SelectedConversation.Title}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
          <Path Grid.Column="2" Classes="icon" Width="13" Height="13" Margin="8,0,0,0" Data="{StaticResource LockIcon}"
                IsVisible="{Binding SelectedConversation.Room.IsEncrypted}" ToolTip.Tip="End-to-end encrypted" VerticalAlignment="Center" />
          <Button Grid.Column="4" Classes="icon memberListToggle" Classes.active="{Binding IsMemberListOpen}" Margin="0,0,-12,0"
                  Command="{Binding ToggleMemberListCommand}" ToolTip.Tip="Members">
            <Path Classes="icon" Data="{StaticResource MembersIcon}" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1">
        <Border Classes="banner" IsVisible="{Binding IsStopped}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Path Classes="icon warning" Data="{StaticResource WarningIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding ConnectionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="link" Content="Back to sign in" Command="{Binding ReturnToLoginCommand}" />
          </Grid>
        </Border>
        <Border Classes="banner" IsVisible="{Binding Issue, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Path Classes="icon warning" Data="{StaticResource WarningIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding Issue}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Padding="4" Command="{Binding DismissIssueCommand}" ToolTip.Tip="Dismiss">
              <Path Classes="icon" Width="12" Height="12" Data="{StaticResource CloseIcon}" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <Panel Grid.Row="2" IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <views:TimelineView DataContext="{Binding SelectedConversation}" />
      </Panel>
      <TextBlock Grid.Row="2" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Select a room" IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNull}}" />

      <Border Grid.Row="3" Classes="composer" Margin="20,6,20,18" Padding="14,3,5,3"
              IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,2" IsVisible="{Binding SelectedConversation.IsReplying}">
            <Path Classes="icon" Width="13" Height="13" Data="{StaticResource ReplyIcon}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="Replying to" />
              <Run FontWeight="SemiBold" Text="{Binding SelectedConversation.ReplyingTo.Sender.DisplayName}" />
              <Run Text="{Binding SelectedConversation.ReplyingTo.PreviewText}" />
            </TextBlock>
            <Button Grid.Column="2" Classes="icon" Padding="4" Command="{Binding SelectedConversation.CancelReplyCommand}"
                    ToolTip.Tip="Cancel reply (Esc)">
              <Path Classes="icon" Width="10" Height="10" Data="{StaticResource CloseIcon}" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="Composer" Classes="composer" MaxHeight="220"
                     Text="{Binding SelectedConversation.Draft}" PlaceholderText="{Binding SelectedConversation.ComposerPlaceholder}" />
            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Bottom" Command="{Binding SelectedConversation.SendCommand}"
                    ToolTip.Tip="Send (Enter). Shift+Enter starts a new line.">
              <Path Classes="icon" Data="{StaticResource SendIcon}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Members of the selected room -->
    <Panel Grid.Column="2" Classes="memberList">
      <Border Width="220" Background="{DynamicResource SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding IsMemberListOpen}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="56" Padding="16,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="Members" />
              <TextBlock Grid.Column="1" Classes="caption tertiary" Text="{Binding JoinedMemberCount}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Members}" Margin="8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MemberViewModel">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="8,5" Background="Transparent" ToolTip.Tip="{Binding ToolTipText}">
                    <Panel VerticalAlignment="Center">
                      <controls:AvatarView Width="24" Height="24" DisplayName="{Binding User.DisplayName}" ColorSeed="{Binding User.UserId}"
                                           AvatarUrl="{Binding User.AvatarUrl}" />
                      <Ellipse Classes="presenceDot small" IsVisible="{Binding HasPresence}"
                               Classes.online="{Binding IsOnline}" Classes.away="{Binding IsAway}" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding User.DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption tertiary" Text="Invited" IsVisible="{Binding IsInvited}" />
                      <TextBlock Classes="caption tertiary" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <views:ImageViewer x:Name="Viewer" Grid.ColumnSpan="3" />
  </Grid>
</UserControl>
