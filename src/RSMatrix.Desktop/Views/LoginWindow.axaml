<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RSMatrix.Desktop.ViewModels"
        x:Class="RSMatrix.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sign in"
        Icon="/Assets/icon.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20" Spacing="14">
    <TextBlock Classes="secondary" Text="Sign in with your Matrix account." />

    <StackPanel Spacing="6">
      <TextBlock Classes="caption secondary" Text="User ID" />
      <TextBox x:Name="UserIdBox" Text="{Binding UserId}" PlaceholderText="@alice:example.org" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="caption secondary" Text="Password" />
      <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="False" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="caption secondary" Text="Homeserver (optional)" />
      <TextBox Text="{Binding Homeserver}" PlaceholderText="Found through the user ID's domain" />
    </StackPanel>

    <ProgressBar IsIndeterminate="True" MinHeight="3" Height="3" IsVisible="{Binding IsConnecting}" />

    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />

    <Button Classes="link" Content="Look around with sample data" Command="{Binding OpenSampleCommand}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button MinWidth="88" HorizontalContentAlignment="Center" IsCancel="True" Content="Cancel" Command="{Binding CancelCommand}" />
      <Button MinWidth="88" HorizontalContentAlignment="Center" Classes="accent" IsDefault="True" Content="Sign in"
              Command="{Binding SignInCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
