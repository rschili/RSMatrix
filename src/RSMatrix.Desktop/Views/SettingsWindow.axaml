<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RSMatrix.Desktop.ViewModels"
        x:Class="RSMatrix.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="/Assets/icon.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20" Spacing="14">
    <TextBlock Classes="title" Text="Appearance" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
      <TextBlock VerticalAlignment="Center" Text="Theme" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ThemeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Font" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" />

      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Text size" />
      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />
    </Grid>

    <Border Classes="composer" Padding="14,10">
      <TextBlock TextWrapping="Wrap" FontFamily="{Binding PreviewFontFamily}" FontSize="{Binding FontSize}"
                 Text="The quick brown fox jumps over the lazy dog. 0123456789" />
    </Border>

    <StackPanel Spacing="2">
      <CheckBox IsChecked="{Binding ShowRoomIcons}" Content="Show room icons" />
      <CheckBox IsChecked="{Binding ShowRoomPreviews}" Content="Show the latest message below room names" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button MinWidth="88" HorizontalContentAlignment="Center" IsCancel="True" Content="Cancel" Command="{Binding CancelCommand}" />
      <Button MinWidth="88" HorizontalContentAlignment="Center" Classes="accent" IsDefault="True" Content="OK"
              Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
