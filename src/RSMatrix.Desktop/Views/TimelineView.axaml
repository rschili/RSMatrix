<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RSMatrix.Desktop.ViewModels"
             xmlns:controls="using:RSMatrix.Desktop.Controls"
             xmlns:views="using:RSMatrix.Desktop.Views"
             xmlns:chat="using:RSMatrix.Desktop.Chat"
             x:Class="RSMatrix.Desktop.Views.TimelineView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ReactionViewModel">
      <Button Classes="reaction" Classes.mine="{Binding IncludesMe}" ToolTip.Tip="{Binding ToolTipText}"
              Command="{Binding $parent[ItemsControl].((vm:MessageViewModel)DataContext).ToggleReactionCommand}"
              CommandParameter="{Binding Key}">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding Key}" FontSize="15" />
          <TextBlock Classes="count" Text="{Binding Count}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- The message that started the thread -->
        <Border Classes="threadRoot" IsVisible="{Binding IsThread}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="52,*" DataContext="{Binding ThreadRoot}" x:DataType="vm:MessageViewModel"
                  IsVisible="{Binding $parent[views:TimelineView].((vm:ConversationViewModel)DataContext).ThreadRoot, Converter={x:Static ObjectConverters.IsNotNull}}">
              <controls:AvatarView Width="36" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                   DisplayName="{Binding Sender.DisplayName}" ColorSeed="{Binding Sender.UserId}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Sender.DisplayName}" ToolTip.Tip="{Binding Sender.UserId}" />
                  <TextBlock Classes="caption tertiary" VerticalAlignment="Bottom" Margin="0,0,0,1"
                             Text="{Binding TimeText}" ToolTip.Tip="{Binding FullTimeText}" />
                </StackPanel>
                <controls:MessageDocumentView Document="{Binding Content}" Classes.notice="{Binding IsNotice}" />
                <ItemsControl Classes="reactions" ItemsSource="{Binding Reactions}" IsVisible="{Binding !!Reactions.Count}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="secondary" Text="The first message of this thread isn't loaded."
                       IsVisible="{Binding IsThreadRootMissing}" />
          </StackPanel>
        </Border>

        <ItemsControl x:Name="Items" ItemsSource="{Binding Timeline.Items}" Padding="0,6,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:DaySeparatorViewModel">
              <Grid ColumnDefinitions="*,Auto,*" Margin="24,18,24,2">
                <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="caption secondary" FontWeight="SemiBold" Margin="12,0" Text="{Binding Text}" />
                <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="vm:MessageViewModel">
              <Border Classes="message" Classes.groupStart="{Binding IsGroupStart}" Classes.pending="{Binding IsPending}" Padding="24,3,18,3">
                <Grid ColumnDefinitions="52,*,72" RowDefinitions="Auto,*">
                  <!-- The message this one replies to -->
                  <Path Classes="replyCurve" IsVisible="{Binding IsReply}" />
                  <TextBlock Grid.Column="1" Classes="caption secondary" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding IsReply}">
                    <Run FontWeight="SemiBold" Text="{Binding ReplyToName}" />
                    <Run Text="{Binding ReplyToPreview}" />
                  </TextBlock>

                  <controls:AvatarView Grid.Row="1" Width="36" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"
                                       IsVisible="{Binding IsGroupStart}"
                                       DisplayName="{Binding Sender.DisplayName}" ColorSeed="{Binding Sender.UserId}" />
                  <TextBlock Grid.Row="1" Classes="hoverTime tertiary" FontSize="11" VerticalAlignment="Top" Margin="0,3,0,0"
                             IsVisible="{Binding !IsGroupStart}" Text="{Binding TimeText}" ToolTip.Tip="{Binding FullTimeText}" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsGroupStart}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Sender.DisplayName}" ToolTip.Tip="{Binding Sender.UserId}" />
                      <TextBlock Classes="caption tertiary" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                 Text="{Binding TimeText}" ToolTip.Tip="{Binding FullTimeText}" />
                    </StackPanel>
                    <controls:MessageDocumentView Document="{Binding Content}" Classes.notice="{Binding IsNotice}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Classes="caption tertiary" Text="{Binding StatusText}" />
                      <Button Classes="link" FontSize="12" Content="Retry" Command="{Binding RetryCommand}" CommandParameter="{Binding}"
                              IsVisible="{Binding SendError, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding SendError}" />
                    </StackPanel>
                    <ItemsControl Classes="reactions" ItemsSource="{Binding Reactions}" IsVisible="{Binding !!Reactions.Count}" />
                    <Button Classes="threadSummary" IsVisible="{Binding Thread.HasReplies, FallbackValue=False}"
                            Command="{Binding $parent[views:TimelineView].((vm:ConversationViewModel)DataContext).OpenThreadCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource ThreadIcon}" />
                        <TextBlock Classes="replies" Text="{Binding Thread.ReplyCountText, FallbackValue={x:Null}}" />
                        <TextBlock Classes="caption tertiary" VerticalAlignment="Center" Text="{Binding Thread.LastReplyText, FallbackValue={x:Null}}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Who has read up to here -->
                  <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Background="Transparent" IsVisible="{Binding HasReaders}" ToolTip.Tip="{Binding ReadersToolTip}">
                    <ItemsControl ItemsSource="{Binding ReaderAvatars}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="-5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="chat:ChatUser">
                          <Border Classes="reader">
                            <controls:AvatarView Width="16" Height="16" DisplayName="{Binding DisplayName}" ColorSeed="{Binding UserId}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="tertiary" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" Text="{Binding ReaderOverflowText}"
                               IsVisible="{Binding ReaderOverflowText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>

                  <!-- Shown while hovering the message -->
                  <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Classes="messageActions" Classes.sent="{Binding IsSent}"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,0,0">
                    <StackPanel Orientation="Horizontal">
                      <ItemsControl ItemsSource="{Binding $parent[views:TimelineView].((vm:ConversationViewModel)DataContext).RecentReactions.Keys}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="emoji" Content="{Binding}" CommandParameter="{Binding}" ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((vm:MessageViewModel)DataContext).ToggleReactionCommand}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="separator" />
                      <Button Classes="icon" ToolTip.Tip="Add reaction" Click="OnAddReactionClick">
                        <Path Classes="icon" Data="{StaticResource AddReactionIcon}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="Reply" CommandParameter="{Binding}"
                              Command="{Binding $parent[views:TimelineView].((vm:ConversationViewModel)DataContext).StartReplyCommand}">
                        <Path Classes="icon" Data="{StaticResource ReplyIcon}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="Reply in thread" CommandParameter="{Binding}"
                              IsVisible="{Binding !$parent[views:TimelineView].((vm:ConversationViewModel)DataContext).IsThread}"
                              Command="{Binding $parent[views:TimelineView].((vm:ConversationViewModel)DataContext).OpenThreadCommand}">
                        <Path Classes="icon" Data="{StaticResource ThreadIcon}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="More" Click="OnMessageMenuClick">
                        <Path Classes="icon" Data="{StaticResource MoreIcon}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" MinHeight="2" Height="2"
                 IsVisible="{Binding LoadOlderMessagesCommand.IsRunning}" />
  </Panel>
</UserControl>
